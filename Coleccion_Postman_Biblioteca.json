{
  "info": {
    "_postman_id": "b1b11073-ca00-4026-9999-5e0a2026b1b1",
    "name": "Biblioteca Escolar SENA 2026 - API Completa",
    "description": "Colección oficial de Postman para el Sistema de Gestión de Biblioteca Escolar (Node.js + Express + Sequelize + Supabase PostgreSQL).\n\nNota: El endpoint 'Iniciar Sesión (Login)' guarda automáticamente el JWT en la variable {{token}} de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación y Seed",
      "item": [
        {
          "name": "Inicializar Base de Datos y Bcrypt (POST /seed)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/seed",
              "host": ["{{base_url}}"],
              "path": ["seed"]
            }
          }
        },
        {
          "name": "Iniciar Sesión - Administrador (POST /auth/login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Token JWT guardado automáticamente');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documento\": \"10001001\",\n  \"contrasena\": \"10001001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Iniciar Sesión - Estudiante (POST /auth/login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documento\": \"30003001\",\n  \"contrasena\": \"30003001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Catálogo de Libros y Ejemplares",
      "item": [
        {
          "name": "Listar Libros con Ejemplares (GET /libros)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/libros",
              "host": ["{{base_url}}"],
              "path": ["libros"]
            }
          }
        },
        {
          "name": "Crear Nuevo Libro (POST /libros)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo_libro\": \"LIB-099\",\n  \"titulo\": \"Arquitectura de Software Moderna\",\n  \"autor\": \"Martin Fowler\",\n  \"area\": \"Tecnología e Informática\",\n  \"anio_publicacion\": 2023\n}"
            },
            "url": {
              "raw": "{{base_url}}/libros",
              "host": ["{{base_url}}"],
              "path": ["libros"]
            }
          }
        },
        {
          "name": "Ver Ejemplares de un Libro (GET /libros/:id/ejemplares)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/libros/1/ejemplares",
              "host": ["{{base_url}}"],
              "path": ["libros", "1", "ejemplares"]
            }
          }
        },
        {
          "name": "Agregar Ejemplar Físico a un Libro (POST /libros/:id/ejemplares)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo_inventario\": \"INV-001-C\",\n  \"condicion\": \"bueno\",\n  \"disponibilidad\": \"disponible\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/libros/1/ejemplares",
              "host": ["{{base_url}}"],
              "path": ["libros", "1", "ejemplares"]
            }
          }
        }
      ]
    },
    {
