              }
            ],
            "url": {
              "raw": "{{base_url}}/solicitudes/mis-prestamos",
              "host": ["{{base_url}}"],
              "path": ["solicitudes", "mis-prestamos"]
            }
          }
        },
        {
          "name": "Mis Solicitudes del Usuario Autenticado (GET /solicitudes/mis-solicitudes)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/solicitudes/mis-solicitudes",
              "host": ["{{base_url}}"],
              "path": ["solicitudes", "mis-solicitudes"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Administración y Carga Masiva Excel",
      "item": [
        {
          "name": "Cargar Usuarios Masivamente desde Excel (POST /admin/usuarios/upload-excel)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "archivo",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/admin/usuarios/upload-excel",
              "host": ["{{base_url}}"],
              "path": ["admin", "usuarios", "upload-excel"]
